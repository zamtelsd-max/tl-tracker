generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  staffId   String   @unique
  pinHash   String
  name      String
  role      Role
  zone      String?
  region    String?
  territory String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  teamLeads  TeamLead[] @relation("ASETeamLeads")
  asTeamLead TeamLead?  @relation("TLUser")
}

enum Role {
  HSD
  ZBM
  ASE
  TL
  ADMIN
  LISTER
}

model LoginLog {
  id       String   @id @default(cuid())
  userId   String
  userName String
  role     String
  zone     String?
  loggedAt DateTime @default(now())

  @@index([role])
  @@index([loggedAt])
  @@map("login_logs")
}

model TeamLead {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation("TLUser", fields: [userId], references: [id])
  aseId           String?
  ase             User?    @relation("ASETeamLeads", fields: [aseId], references: [id])
  zone            String?
  region          String?
  allocatedTarget Int      @default(50)
  createdAt       DateTime @default(now())

  dsas        DSA[]
  activations Activation[]
  registeredNumbers RegisteredNumber[]
  grossAdds   GrossAdd[]
  alerts      Alert[]
}

model DSA {
  id         String    @id @default(cuid())
  teamLeadId String
  teamLead   TeamLead  @relation(fields: [teamLeadId], references: [id])
  name       String
  phone      String?
  dealerCode String?
  status     DSAStatus @default(ACTIVE)
  dateJoined DateTime  @default(now())
  createdAt  DateTime  @default(now())

  // Login account (DSAs can sign in) — columns already exist in DB
  staffId       String?  @unique
  pinHash       String?
  mustChangePin Boolean  @default(true)

  activations Activation[]
  registeredNumbers RegisteredNumber[]
  grossAdds   GrossAdd[]
  attendances Attendance[]

  @@unique([teamLeadId, name])
}

// Gate-meeting attendance / clock-in (columns already exist in DB)
model Attendance {
  id              String    @id @default(cuid())
  dsaId           String
  dsa             DSA       @relation(fields: [dsaId], references: [id])
  teamLeadId      String
  date            String
  clockInAt       DateTime?
  onTime          Boolean   @default(false)
  latitude        Float?
  longitude       Float?
  locationOk      Boolean   @default(true)
  firstCustomerAt DateTime?
  timeToFirstMin  Int?
  worked          Boolean   @default(true)
  approved        Boolean   @default(false)
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@unique([dsaId, date])
  @@index([teamLeadId, date])
}

enum DSAStatus {
  ACTIVE
  INACTIVE
}

model Activation {
  id              String   @id @default(cuid())
  teamLeadId      String
  teamLead        TeamLead @relation(fields: [teamLeadId], references: [id])
  dsaId           String
  dsa             DSA      @relation(fields: [dsaId], references: [id])
  customerName    String?
  count           Int      @default(1)
  registeredCount Int?
  hourSlot        String
  date            String
  latitude        Float?
  longitude       Float?
  notes           String?
  createdAt       DateTime @default(now())
}

model Alert {
  id           String      @id @default(cuid())
  teamLeadId   String?
  teamLead     TeamLead?   @relation(fields: [teamLeadId], references: [id])
  type         AlertType
  message      String
  targetUserId String?
  status       AlertStatus @default(SENT)
  createdAt    DateTime    @default(now())
}

enum AlertType {
  ZERO_ACTIVITY
  MISSED_TARGET
  END_OF_DAY
  ESCALATION
}

enum AlertStatus {
  SENT
  READ
  RESOLVED
}

model RegisteredNumber {
  id         String   @id @default(cuid())
  teamLeadId String
  teamLead   TeamLead @relation(fields: [teamLeadId], references: [id])
  dsaId      String?
  dsa        DSA?     @relation(fields: [dsaId], references: [id])
  msisdn     String
  date       String
  createdAt  DateTime @default(now())
}

model GrossAdd {
  id              String   @id @default(cuid())
  teamLeadId      String
  teamLead        TeamLead @relation(fields: [teamLeadId], references: [id])
  dsaId           String
  dsa             DSA      @relation(fields: [dsaId], references: [id])
  msisdn          String
  amountRecharged Float?
  walletActivated Boolean  @default(false)
  firstDeposit    Float?
  hourSlot        String
  date            String
  latitude        Float?
  longitude       Float?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([teamLeadId, date])
  @@index([dsaId, date])
}
